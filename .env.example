# Copy to .env and edit as needed (loaded automatically if python-dotenv is installed).

OLLAMA_BASE_URL=http://localhost:11434
CHROMA_HOST=http://localhost:8000

# 12GB-friendly models (NOT Llama-3.1-70B). Point both at one model if you prefer.
CODE_MODEL=qwen2.5-coder:7b
REASONING_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

COLLECTION=osv_advisories
RETRIEVE_K=4

SEMGREP_CONFIG=vulnfix_rules.yml,p/default,p/security-audit,p/owasp-top-ten,p/cwe-top-25,p/python,p/java
MAX_PATCH_ATTEMPTS=2
